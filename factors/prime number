n = int(input("Enter a number: "))

print(f"Prime numbers up to {n} are:")

for num in range(2, n + 1):
    c = 0
    for i in range(2, num + 1):
        if num % i == 0:
            c += 1
    if c == 1:  # Prime numbers have exactly 2 factors: 1 and itself
        print(num, end=" ")